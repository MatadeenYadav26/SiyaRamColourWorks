---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Story from '../components/Story.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Promise from '../components/Promise.astro';
import Enquiry from '../components/Enquiry.astro';
import Footer from '../components/Footer.astro';
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<Base>
  <link slot="head" rel="preload" as="image" href={`${baseUrl}frames/frame_0001.webp`} fetchpriority="high" media="(min-width: 768px)" />
  <link slot="head" rel="preload" as="image" href={`${baseUrl}images/hero-mobile-start.webp`} fetchpriority="high" media="(max-width: 767px)" />
  <Hero />
  <Intro />
  <Story />
  <Services />
  <Work />
  <Promise />
  <Enquiry />
  <Footer />
</Base>
