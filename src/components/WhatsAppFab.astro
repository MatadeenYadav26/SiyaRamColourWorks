---
import { site, fab } from '../content/site';
---
<a class="fab" href={site.whatsapp} target="_blank" rel="noopener" aria-label={fab.aria} data-magnetic>
  <span class="fab-ring" aria-hidden="true"></span>
  <svg class="fab-icon" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    <path fill="currentColor" d="M16 3C9 3 3.3 8.7 3.3 15.7c0 2.4.7 4.7 1.9 6.7L3 29l6.8-2.1c1.9 1.1 4.1 1.6 6.2 1.6 7 0 12.7-5.7 12.7-12.7S23 3 16 3zm0 23.2c-2 0-3.9-.5-5.6-1.6l-.4-.2-4 1.2 1.3-3.9-.3-.4c-1.2-1.8-1.8-3.8-1.8-5.9C5.2 9.8 10 5 16 5s10.8 4.8 10.8 10.7S21.9 26.2 16 26.2zm5.9-8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 .8.3 1.4.5 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/>
  </svg>
  <span class="fab-label">{fab.label}</span>
</a>

<style>
  .fab {
    position: fixed;
    right: calc(20px + env(safe-area-inset-right));
    bottom: calc(20px + env(safe-area-inset-bottom));
    z-index: 60;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--wa, #25D366);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .18);
    text-decoration: none;
  }
  .fab-icon { position: relative; z-index: 1; }
  .fab-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--wa, #25D366);
    animation: fab-pulse 2.4s var(--ease-out, ease-out) infinite;
  }
  .fab-label {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    white-space: nowrap;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font: 600 13px/1 var(--sans);
    opacity: 0;
    transform: translate(8px, -50%);
    pointer-events: none;
    transition: opacity .3s, transform .3s var(--ease-out, ease-out);
  }
  .fab:hover .fab-label,
  .fab:focus-visible .fab-label { opacity: 1; transform: translate(0, -50%); }
  .fab:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  @keyframes fab-pulse {
    0% { transform: scale(1); opacity: .5; }
    100% { transform: scale(1.7); opacity: 0; }
  }
  @media (hover: none) { .fab-label { display: none; } }
  /* Mobile hero already has its own WhatsApp button: keep the bubble out of the way until scrolling past it */
  .fab { transition: opacity .35s var(--ease-out, ease-out), visibility .35s; }
  :global(html.hero-in-view) .fab, :global(html.footer-in-view) .fab, :global(html.profile-open) .fab { opacity: 0; visibility: hidden; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .fab-ring { animation: none; opacity: 0; } }
</style>

<script>
  import { initMagnetic } from '../scripts/magnetic';
  initMagnetic('.fab');
</script>
