---
// Scroll-scrubbed frame sequence. Animation logic unchanged from the approved test page.
import { hero, site, heroMobile } from '../content/site';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<section class="hero" id="hero">
  <!-- Mobile hero (<768px): short intro film + headline + actions. Desktop keeps the scroll sequence. -->
  <div class="hero-m">
    <div class="hero-m__media" data-hero-media>
    <video
      class="hero-m__video"
      muted
      playsinline
      preload="none"
      poster={`${base}images/hero-mobile-start.webp`}
      data-src={`${base}video/hero-mobile.mp4`}
      data-end-poster={`${base}images/hero-mobile-end.webp`}
      aria-hidden="true"
      tabindex="-1"
    ></video>
    </div>
    <div class="hero-m__shade" aria-hidden="true"></div>
    <div class="hero-m__content">
      <p class="hero-m__eyebrow"><span></span>{heroMobile.eyebrow}</p>
      <h1 class="hero-m__title">{heroMobile.title.pre} <em>{heroMobile.title.em}</em>{heroMobile.title.end}</h1>
      <p class="hero-m__lead">{heroMobile.lead}</p>
      <div class="hero-m__actions">
        <a class="hero-m__btn hero-m__btn--primary" href="#enquiry">{heroMobile.primary}<span aria-hidden="true">→</span></a>
        <a class="hero-m__btn hero-m__btn--ghost" href={site.whatsapp} target="_blank" rel="noopener">{heroMobile.secondary}</a>
      </div>
      <p class="hero-m__meta">{heroMobile.meta}</p>
    </div>
  </div>
  <canvas id="seq" aria-label="Scroll animation"></canvas>
  {hero.messages.map((m) => (
    <div class={`msg ${m.cls}`} data-from={m.from} data-to={m.to}>
      <span class="eyebrow">{m.eyebrow}</span>
      <h2 set:html={m.html} />
    </div>
  ))}
  <div class="hero__veil" aria-hidden="true"></div>
  <!-- Desktop opening card: explains the story before the first scroll, then gets out of the way -->
  <div class="hero-open" data-hero-open>
    <p class="hero-open__eyebrow"><span></span>{hero.open.eyebrow}<span></span></p>
    <p class="hero-open__title">
      {hero.open.title.pre} <em>{hero.open.title.em}<svg viewBox="0 0 220 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16c38-9 92-12 136-8s58 4 76-2" /></svg></em>{hero.open.title.end}
    </p>
    <p class="hero-open__lead">{hero.open.lead}</p>
  </div>
  <button type="button" class="scroll-cue" data-scroll-cue aria-label="Scroll down to start">
    <span class="scroll-cue__in">
    <span class="scroll-cue__mouse" aria-hidden="true"><i></i></span>
    <span class="scroll-cue__label">{hero.scrollCue}</span>
    <span class="scroll-cue__chev" aria-hidden="true">
      <svg viewBox="0 0 24 14"><path d="M3 3l9 8 9-8" /></svg>
      <svg viewBox="0 0 24 14"><path d="M3 3l9 8 9-8" /></svg>
      <svg viewBox="0 0 24 14"><path d="M3 3l9 8 9-8" /></svg>
    </span>
    </span>
  </button>
</section>

<div class="hud" id="loader">0%</div>

<style is:global>
  .hero { position: relative; height: 100vh; overflow: hidden; background: #000; z-index: 2; }
  #seq { display: block; width: 100vw; height: 100vh; transform-origin: 50% 40%; will-change: transform; }
  .hero__veil { position: absolute; inset: 0; z-index: 7; background: #0d0c0b; opacity: 0; pointer-events: none; }
  /* Desktop: page 1 rises over the held final frame (the pin adds HOLD + COVER screens) */
  @media (min-width: 768px) { #intro { margin-top: -100vh; } }
  .hud {
    position: fixed; z-index: 10; font: 12px/1 ui-monospace, Menlo, Consolas, monospace;
    color: #fff; background: rgba(0,0,0,.55); padding: 6px 8px; border-radius: 4px;
    pointer-events: none;
  }
  #loader { left: 50%; top: 50%; transform: translate(-50%, -50%); font-size: 14px; }
  .msg {
    position: absolute; z-index: 5; color: #fffaf0; pointer-events: none;
    opacity: 0; will-change: transform, opacity;
    font-family: 'Montserrat', system-ui, sans-serif;
  }
  .msg::before {
    content: ''; position: absolute; z-index: -1; inset: -60% -25%;
    background: radial-gradient(closest-side, rgba(10,8,20,.62), rgba(10,8,20,.3) 55%, transparent);
    filter: blur(6px);
  }
  .msg .eyebrow {
    display: inline-flex; align-items: center; gap: .8em;
    font-size: clamp(11px, 1vw, 13px); font-weight: 700;
    letter-spacing: .32em; text-transform: uppercase; color: #ffcf4a;
    margin-bottom: .9em;
    text-shadow: 0 1px 2px rgba(0,0,0,.8), 0 0 14px rgba(0,0,0,.6);
  }
  .msg h2 {
    margin: 0; font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 600; line-height: 1.08; letter-spacing: -.02em;
    font-size: clamp(34px, 5.2vw, 76px);
    text-shadow: 0 2px 3px rgba(0,0,0,.55), 0 6px 24px rgba(0,0,0,.55), 0 0 2px rgba(0,0,0,.4);
  }
  .msg h2 em { font-style: normal; color: #ffcf4a; }
  .msg h2 .w { display: inline-block; will-change: transform, opacity; }

  .msg.center, .msg.end { left: 0; right: 0; bottom: 16vh; text-align: center; padding: 0 6vw; }
  .msg.center .eyebrow::before, .msg.center .eyebrow::after,
  .msg.end .eyebrow::before, .msg.end .eyebrow::after {
    content: ''; width: 2.2em; height: 1px; background: currentColor; opacity: .8;
  }
  .msg.end { bottom: 9vh; }

  .msg.left {
    left: 6vw; bottom: 12vh; max-width: min(620px, 84vw); text-align: left;
    padding-left: 1.1em; border-left: 3px solid #ffcf4a;
  }
  .msg.left::before { inset: -50% -40% -50% -30%; }
  .msg.left h2 { font-size: clamp(32px, 4.3vw, 62px); }

  @media (max-width: 600px) {
    .msg.center, .msg.end, .msg.left {
      left: 0; right: 0; top: 58%; bottom: auto;
      max-width: none; padding: 0 7vw; border-left: 0; text-align: center;
    }
    .msg.left::before { inset: -60% -25%; }
    .msg.left h2 { font-size: clamp(30px, 7.5vw, 46px); }
  }

  /* ---------- desktop opening card ---------- */
  .hero-open {
    position: absolute; z-index: 6; left: 0; right: 0; top: 50%; transform: translateY(-58%);
    text-align: center; color: #fffaf0; pointer-events: none; padding: 0 6vw;
    will-change: transform, opacity;
  }
  .hero-open::before {
    content: ''; position: absolute; inset: -45% -10%; z-index: -1;
    background: radial-gradient(50% 50% at 50% 50%, rgba(10, 10, 12, .55), rgba(10, 10, 12, 0) 70%);
  }
  .hero-open__eyebrow {
    display: inline-flex; align-items: center; gap: 14px; margin: 0 0 22px;
    font: 600 13px/1 var(--sans); letter-spacing: .26em; text-transform: uppercase; color: rgba(255, 250, 240, .85);
    animation: openRise 1.1s var(--ease-expo) .2s both;
  }
  .hero-open__eyebrow span { width: 34px; height: 1px; background: rgba(255, 207, 74, .8); }
  .hero-open__title {
    margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(52px, 6.6vw, 112px);
    line-height: 1; letter-spacing: -.03em; text-shadow: 0 6px 40px rgba(0, 0, 0, .35);
    animation: openRise 1.3s var(--ease-expo) .35s both;
  }
  .hero-open__title em { position: relative; display: inline-block; font-style: italic; color: #cfd2d6; }
  .hero-open__title em svg { position: absolute; left: -4%; bottom: -.12em; width: 108%; height: .26em; overflow: visible; }
  .hero-open__title em path {
    fill: none; stroke: #ffcf4a; stroke-width: 7; stroke-linecap: round;
    stroke-dasharray: 260; stroke-dashoffset: 260; animation: openStroke 1.2s var(--ease-out) 1.2s forwards;
  }
  .hero-open__lead {
    margin: 26px auto 0; max-width: 40ch; font-size: clamp(17px, 1.35vw, 21px); line-height: 1.5; color: rgba(255, 250, 240, .86);
    animation: openRise 1.2s var(--ease-expo) .55s both;
  }
  @keyframes openRise { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  @keyframes openStroke { to { stroke-dashoffset: 0; } }

  .scroll-cue {
    position: absolute; z-index: 6; left: 50%; bottom: 4vh; transform: translateX(-50%);
    padding: 10px 18px; border: 0; background: none; cursor: pointer;
    color: #fffaf0; font: 600 13px/1 var(--sans); letter-spacing: .24em; text-transform: uppercase;
    transition: opacity .5s var(--ease-out);
  }
  .scroll-cue__in { display: flex; flex-direction: column; align-items: center; gap: 12px; animation: openRise 1.2s var(--ease-expo) .9s both; }
  .scroll-cue__mouse {
    position: relative; width: 28px; height: 44px; border: 2px solid rgba(255, 250, 240, .85); border-radius: 16px;
  }
  .scroll-cue__mouse i {
    position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; margin-left: -2px; border-radius: 2px;
    background: #ffcf4a; animation: wheel 1.6s var(--ease-out) infinite;
  }
  .scroll-cue__label { text-shadow: 0 2px 12px rgba(0, 0, 0, .4); }
  .scroll-cue__chev { display: flex; flex-direction: column; align-items: center; margin-top: -2px; }
  .scroll-cue__chev svg { width: 20px; height: 11px; margin-top: -3px; fill: none; stroke: #ffcf4a; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; opacity: 0; animation: chev 1.6s ease-in-out infinite; }
  .scroll-cue__chev svg:nth-child(2) { animation-delay: .18s; }
  .scroll-cue__chev svg:nth-child(3) { animation-delay: .36s; }
  .scroll-cue:hover .scroll-cue__mouse { border-color: #ffcf4a; }
  .scroll-cue:focus-visible { outline: 2px solid #ffcf4a; outline-offset: 4px; border-radius: 8px; }
  @keyframes wheel { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 100% { transform: translateY(0); opacity: 0; } }
  @keyframes chev { 0% { opacity: 0; transform: translateY(-4px); } 40% { opacity: 1; } 80%, 100% { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) {
    .hero-open__eyebrow, .hero-open__title, .hero-open__lead, .scroll-cue__in { animation: none; }
    .hero-open__title em path { animation: none; stroke-dashoffset: 0; }
    .scroll-cue__mouse i, .scroll-cue__chev svg { animation: none; opacity: 1; }
  }
  /* ---------- Mobile hero ---------- */
  .hero-m { display: none; }
  @media (max-width: 767px) {
    .hero { height: 100svh; min-height: 600px; max-height: 960px; background: #12110f; }
    #seq, .hero .msg, .hero .scroll-cue, .hero-open, #loader { display: none !important; }
    .hero-m { display: block; position: absolute; inset: 0; overflow: hidden; color: #fffaf0; }
    .hero-m__media { position: absolute; inset: 0; will-change: transform; }
    #intro { margin-top: -36px; }
    .hero-m__video {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      transform: scale(1.04); animation: heroDrift 14s var(--ease-out) forwards;
      background: #2a2a2a;
    }
    @keyframes heroDrift { to { transform: scale(1); } }
    .hero-m__shade {
      position: absolute; inset: 0; pointer-events: none;
      background:
        linear-gradient(180deg, rgba(12,11,10,.55) 0%, rgba(12,11,10,0) 22%),
        linear-gradient(0deg, rgba(12,11,10,.92) 0%, rgba(12,11,10,.72) 30%, rgba(12,11,10,0) 62%);
    }
    .hero-m__content {
      position: absolute; left: 0; right: 0; bottom: 0;
      padding: 0 24px calc(64px + env(safe-area-inset-bottom));
    }
    .hero-m__content > * { opacity: 0; transform: translateY(14px); animation: heroIn .9s var(--ease-expo) forwards; }
    .hero-m__eyebrow { animation-delay: .25s !important; }
    .hero-m__title { animation-delay: .38s !important; }
    .hero-m__lead { animation-delay: .52s !important; }
    .hero-m__actions { animation-delay: .66s !important; }
    .hero-m__meta { animation-delay: .8s !important; }
    @keyframes heroIn { to { opacity: 1; transform: none; } }

    .hero-m__eyebrow {
      display: flex; align-items: center; gap: 10px;
      font: 600 12px/1.2 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: #ffcf4a;
      margin-bottom: 14px;
    }
    .hero-m__eyebrow span { width: 24px; height: 1px; background: currentColor; }
    .hero-m__title {
      font-family: var(--serif); font-weight: 400; font-size: clamp(40px, 11.5vw, 54px);
      line-height: 1; letter-spacing: -.025em; color: #fffaf0; margin: 0;
    }
    .hero-m__title em { font-style: italic; color: #ffcf4a; }
    .hero-m__lead {
      margin-top: 14px; max-width: 32ch;
      font-size: 15.5px; line-height: 1.5; color: rgba(255,250,240,.82);
    }
    .hero-m__actions { display: flex; gap: 10px; margin-top: 24px; }
    .hero-m__btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      min-height: 52px; padding: 0 20px; border-radius: 2px;
      font: 600 15px/1 var(--sans); letter-spacing: .01em; text-decoration: none;
      -webkit-tap-highlight-color: transparent; transition: transform .2s var(--ease-out), background-color .2s;
    }
    .hero-m__btn:active { transform: scale(.97); }
    .hero-m__btn--primary { flex: 1.4; background: #fffaf0; color: var(--ink); }
    .hero-m__btn--ghost { flex: 1; color: #fffaf0; border: 1px solid rgba(255,250,240,.45); background: rgba(255,250,240,.06); backdrop-filter: blur(6px); }
    .hero-m__meta {
      margin-top: 22px; padding-top: 16px; border-top: 1px solid rgba(255,250,240,.16);
      font-size: 12.5px; letter-spacing: .06em; color: rgba(255,250,240,.62);
    }
  }
  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .hero-m__video { animation: none; transform: none; }
    .hero-m__content > * { opacity: 1; transform: none; animation: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);

  const COUNT = 179;
  const BASE_URL = import.meta.env.BASE_URL;
  const SCROLL_SCREENS = 4; // pin length in screen heights
  const isMobile = window.matchMedia('(max-width: 767px)').matches;
  const HOLD = 0.35;  // screens to hold the final frame + end message
  const COVER = 1;    // screens while page 1 slides up over the hero
  const TOTAL = SCROLL_SCREENS + HOLD + COVER;
  const veil = document.querySelector<HTMLElement>('.hero__veil');
  const openEl = document.querySelector<HTMLElement>('[data-hero-open]');
  const isTouch = window.matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;
  const src = (i: number) => `${BASE_URL}frames/frame_${String(i + 1).padStart(4, '0')}.webp`;

  const canvas = document.getElementById('seq') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const loaderEl = document.getElementById('loader')!;

  const frames: (HTMLImageElement | null)[] = new Array(COUNT).fill(null);
  let current = 0;
  let drawn = -1;
  const t0 = performance.now();
  const stats: any = ((window as any).__stats = { firstFrameMs: 0, allLoadedMs: 0, draws: 0 });

  // ---- canvas sizing (cover fit, high-DPI) ----
  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, isTouch ? 1.5 : 2);
    canvas.width = Math.round(window.innerWidth * dpr);
    canvas.height = Math.round(window.innerHeight * dpr);
    drawn = -1;
    render();
  }

  function nearestLoaded(i: number) {
    if (frames[i]) return i;
    for (let d = 1; d < COUNT; d++) {
      if (i - d >= 0 && frames[i - d]) return i - d;
      if (i + d < COUNT && frames[i + d]) return i + d;
    }
    return -1;
  }

  // ---- portrait (mobile) logo framing ----
  const REVEAL_START = 129;
  const REVEAL_END = 150;
  const FX = 0.51, FY = 0.46;
  const LOGO_W = 1100;
  const smooth = (t: number) => t * t * (3 - 2 * t);

  function render() {
    const i = nearestLoaded(current);
    if (i < 0 || i === drawn) return;
    const img = frames[i]!;
    const iw = img.naturalWidth, ih = img.naturalHeight;
    const cw = canvas.width, ch = canvas.height;
    const cover = Math.max(cw / iw, ch / ih);

    if (cw >= ch) {
      const w = iw * cover, h = ih * cover;
      ctx.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
    } else {
      const t = smooth(Math.max(0, Math.min(1, (i - REVEAL_START) / (REVEAL_END - REVEAL_START))));
      const fit = Math.min(cover, (cw * 0.92) / (LOGO_W * (iw / 1920)));
      const scale = cover + (fit - cover) * t;
      const w = iw * scale, h = ih * scale;
      let x = cw / 2 - FX * w, y = ch / 2 - FY * h;
      x = w >= cw ? Math.min(0, Math.max(cw - w, x)) : x;
      y = h >= ch ? Math.min(0, Math.max(ch - h, y)) : y;
      if (t > 0) {
        const cwid = iw * cover, chei = ih * cover;
        ctx.save();
        ctx.filter = 'blur(24px) brightness(0.45)';
        ctx.drawImage(img, cw / 2 - FX * cwid, (ch - chei) / 2, cwid, chei);
        ctx.restore();
      }
      ctx.drawImage(img, x, y, w, h);
    }
    drawn = i;
    stats.draws++;
  }

  function setFrame(i: number) {
    i = Math.max(0, Math.min(COUNT - 1, i));
    if (i === current) return;
    current = i;
    requestAnimationFrame(render);
  }

  // ---- preload: frame 1 first, then the rest ----
  function load(i: number) {
    return new Promise<void>((resolve) => {
      const img = new Image();
      img.decoding = 'async';
      img.src = src(i);
      const finish = () => {
        if (img.naturalWidth) frames[i] = img;
        resolve();
      };
      img.onload = finish;
      img.onerror = finish;
      if (img.complete) finish();
    });
  }

  let loaded = 0;
  async function preload() {
    await load(0);
    stats.firstFrameMs = Math.round(performance.now() - t0);
    loaded = 1;
    resize();
    // Coarse-to-fine order: every 8th frame first, then 4th, 2nd, rest.
    // The animation is scrubbable almost immediately; gaps fill in after.
    const order: number[] = [];
    const seen = new Set<number>([0]);
    for (const step of [8, 4, 2, 1]) {
      for (let i = step; i < COUNT; i += step) if (!seen.has(i)) { seen.add(i); order.push(i); }
    }
    const rest = [];
    for (const i of order) {
      rest.push(load(i).then(() => {
        loaded++;
        loaderEl.textContent = `${Math.round((loaded / COUNT) * 100)}%`;
        requestAnimationFrame(render);
      }));
    }
    await Promise.all(rest);
    stats.allLoadedMs = Math.round(performance.now() - t0);
    console.log(`[frames] first frame ${stats.firstFrameMs} ms, all ${COUNT} loaded in ${stats.allLoadedMs} ms`);
    loaderEl.textContent = '100%';
    setTimeout(() => (loaderEl.style.display = 'none'), 400);
  }

  // ---- smooth scroll (desktop only) ----
  if (!isTouch) {
    const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
    (window as any).__lenis = lenis;
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  // ---- scroll-linked text ----
  const FADE = 9;
  const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
  const msgs = Array.from(document.querySelectorAll<HTMLElement>('.msg')).map((el) => {
    const h = el.querySelector('h2')!;
    const wrap = (t: string) => t.split(/(\s+)/).map((s) => (s.trim() ? `<span class="w">${s}</span>` : s)).join('');
    h.innerHTML = Array.from(h.childNodes)
      .map((n) => (n.nodeType === 3 ? wrap(n.textContent!) : `<em>${wrap(n.textContent!)}</em>`))
      .join('');
    return {
      el, from: +el.dataset.from!, to: +el.dataset.to!,
      words: Array.from(h.querySelectorAll<HTMLElement>('.w')),
    };
  });
  let mx = 0, my = 0;
  let lastF = 0;

  function updateText(f: number) {
    lastF = f;
    for (const m of msgs) {
      const vis = Math.min(clamp01((f - m.from) / FADE), clamp01((m.to - f) / FADE));
      const p = clamp01((f - m.from) / (m.to - m.from));
      const drift = (0.5 - p) * 50;
      m.el.style.opacity = String(vis);
      m.el.style.transform = `translate3d(${mx * -14}px, ${drift + my * -8}px, 0)`;
      m.words.forEach((w, k) => {
        const inT = clamp01((f - m.from - k * 1.6) / 7);
        const outT = clamp01((m.to - f - (m.words.length - 1 - k) * 1.2) / 7);
        const t = smooth(Math.min(inT, outT));
        w.style.opacity = String(t);
        w.style.transform = `translateY(${(1 - t) * 0.6}em)`;
      });
    }
  }

  if (!isTouch) {
    window.addEventListener('pointermove', (e) => {
      mx = e.clientX / window.innerWidth - 0.5;
      my = e.clientY / window.innerHeight - 0.5;
      requestAnimationFrame(() => updateText(lastF));
    });
  }
  updateText(0);

  // ---- scroll -> frame (after text setup: onUpdate fires during create) ----
  if (!isMobile) ScrollTrigger.create({
    trigger: '#hero',
    start: 'top top',
    end: () => `+=${window.innerHeight * TOTAL}`,
    pin: true,
    scrub: true,
    invalidateOnRefresh: true,
    onUpdate: (self) => {
      const sc = self.progress * TOTAL;
      const f = Math.min(1, sc / SCROLL_SCREENS) * (COUNT - 1);
      setFrame(Math.round(f));
      updateText(f);
      // opening card lifts away over the first frames, well before the first message
      if (openEl) {
        const o = clamp01(f / 16);
        openEl.style.opacity = String(1 - o);
        openEl.style.transform = `translateY(calc(-58% - ${o * 8}vh)) scale(${1 - o * 0.04})`;
        openEl.style.visibility = o >= 1 ? 'hidden' : '';
      }
      // handoff: dim and gently recede while page 1 rises over the hero
      const q = clamp01((sc - SCROLL_SCREENS - HOLD) / COVER);
      if (veil) veil.style.opacity = String(q * 0.35);
      canvas.style.transform = q > 0 ? `translate3d(0, ${-q * 6}vh, 0) scale(${1 + q * 0.06})` : '';
    },
  });

  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => { resize(); ScrollTrigger.refresh(); }, 100);
  });

  // scroll cue hides once the user starts scrolling; clicking it starts the story
  const cue = document.querySelector<HTMLElement>('.scroll-cue');
  const onCue = () => {
    if (!cue) return;
    const away = window.scrollY > 40;
    cue.style.opacity = away ? '0' : '1';
    cue.style.pointerEvents = away ? 'none' : '';
  };
  window.addEventListener('scroll', onCue, { passive: true });
  cue?.addEventListener('click', () => {
    const lenis = (window as any).__lenis;
    const y = window.innerHeight * 1.1;
    if (lenis) lenis.scrollTo(y, { duration: 2.2 });
    else window.scrollTo({ top: y, behavior: 'smooth' });
  });

  // ---- mobile: play the short intro film once, then hold on its last frame ----
  function initMobile() {
    loaderEl.style.display = 'none';
    const heroEl = document.getElementById('hero');
    if (heroEl) {
      document.documentElement.classList.add('hero-in-view');
      new IntersectionObserver(([e]) => {
        document.documentElement.classList.toggle('hero-in-view', e.intersectionRatio > 0.35);
      }, { threshold: [0, 0.35, 1] }).observe(heroEl);
    }
    const v = document.querySelector<HTMLVideoElement>('.hero-m__video');
    if (!v) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.poster = v.dataset.endPoster!;
      return;
    }
    const media = document.querySelector<HTMLElement>('[data-hero-media]');
    const content = document.querySelector<HTMLElement>('.hero-m__content');
    let ticking = false;
    const onScroll = () => {
      ticking = false;
      const y = window.scrollY, h = window.innerHeight;
      if (y > h * 1.2) return;
      if (media) media.style.transform = `translate3d(0, ${y * 0.4}px, 0)`;
      if (content) {
        content.style.opacity = String(Math.max(0, 1 - y / (h * 0.55)));
        content.style.transform = `translate3d(0, ${-y * 0.12}px, 0)`;
      }
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
    v.src = v.dataset.src!;
    v.muted = true;
    v.play().catch(() => { v.poster = v.dataset.endPoster!; });
  }

  if (isMobile) initMobile();
  else preload();
</script>
