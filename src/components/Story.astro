---
import { story } from '../content/site';
const people = story.people;
---
<section id="story" class="story tint-linen seam" style="--seam-from:linear-gradient(90deg,#F4F0E8 0%,#F2EDE4 45%,#ECE5D7 100%)" aria-labelledby="story-title">
  <div class="wrap story__grid">
    <div class="story__text">
      <p class="label" data-story-fade>{story.label}</p>
      <h2 id="story-title" class="story__title split">
        {story.heading.map((l) => (
          <span class="line"><span>{l}</span></span>
        ))}
      </h2>
      <span class="story__rule" aria-hidden="true" data-story-rule></span>
      <p class="story__lead" data-story-fade>{story.line}</p>
      <p class="story__hint" data-story-fade><span class="story__hint-dot" aria-hidden="true"></span>{story.hint}</p>
    </div>
    <div class="story__people">
      {people.map((p, i) => (
        <figure class={`story__person story__person--${i + 1}`} data-person={i}>
          <button type="button" class="story__open" data-story-open={i} aria-haspopup="dialog" aria-label={`${story.meet} ${p.name}, ${p.role}`}>
            <span class="story__tilt" data-tilt>
              <span class="story__frame reveal" data-story-media>
                <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
                <span class="story__shine" aria-hidden="true"></span>
              </span>
              <span class="story__plus" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
            </span>
          </button>
          <figcaption class="story__cap">
            <span class="story__name">{p.name}</span>
            <span class="story__role">{p.role}</span>
          </figcaption>
          <!-- phone: a simple read-more toggle instead of the full-screen profile -->
          <button type="button" class="story__more" data-story-more aria-expanded="false" aria-controls={`story-bio-${i}`}>
            <span>{p.more}</span><i aria-hidden="true"></i>
          </button>
        </figure>
      )).flatMap((fig, i) => [fig, (
        <div class={`story__bio-m story__bio-m--${i + 1}`} id={`story-bio-${i}`} hidden>
          <p class="story__bio-q">“{people[i].quote}”</p>
          {people[i].bio.map((b) => <p>{b}</p>)}
        </div>
      )])}
    </div>
  </div>

  <!-- desktop profile: the portrait grows to the left, the story writes itself on the right -->
  <div class="profile" data-profile hidden role="dialog" aria-modal="true" aria-labelledby="profile-name-0">
    <div class="profile__backdrop" data-profile-close></div>
    <div class="profile__stage">
      <div class="profile__bg" aria-hidden="true" data-profile-bg></div>
      <div class="profile__media" data-profile-slot></div>
      <div class="profile__bodies">
        {people.map((p, i) => (
          <article class="profile__body" data-body={i} data-bg={p.bgWord} hidden>
            <p class="profile__eyebrow" data-pf><span></span>{p.eyebrow}</p>
            <h3 class="profile__name" id={`profile-name-${i}`} aria-label={p.name}>
              {p.name.split(' ').map((w) => (
                <span class="pw">{[...w].map((c) => <span class="pc">{c}</span>)}</span>
              ))}
            </h3>
            <p class="profile__role" data-pf>{p.role}</p>
            <span class="profile__rule" data-pf-rule aria-hidden="true"></span>
            <blockquote class="profile__quote" data-pf>“{p.quote}”</blockquote>
            {p.bio.map((b) => <p class="profile__bio" data-pf>{b}</p>)}
            <dl class="profile__facts">
              {p.facts.map((f) => (
                <div class="profile__fact" data-pf-fact><dt>{f.k}</dt><dd>{f.v}</dd></div>
              ))}
            </dl>
            <button type="button" class="profile__next" data-profile-next={(i + 1) % people.length} data-pf>
              <span>{story.meet} {people[(i + 1) % people.length].name}</span>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </article>
        ))}
      </div>
      <button type="button" class="profile__close" data-profile-close aria-label={story.close}>
        <span>{story.close}</span>
        <i aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></i>
      </button>
    </div>
  </div>
</section>

<style>
  .story { position: relative; z-index: 3; padding-block: var(--section-y); }
  .story__grid {
    display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 112px); align-items: start;
  }
  .story__text { position: sticky; top: 18vh; }
  .story__title {
    font-family: var(--serif); font-weight: 500;
    font-size: clamp(40px, 5.4vw, 92px);
    line-height: 0.98; letter-spacing: -0.02em; margin: clamp(18px, 2vw, 28px) 0 0;
  }
  .story__title .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .story__title .line > span { display: inline-block; }
  .story__rule { display: block; width: clamp(64px, 8vw, 120px); height: 2px; background: var(--gold); margin: clamp(24px, 3vw, 40px) 0; transform-origin: left center; }
  .story__lead { font-size: var(--fs-lead); color: var(--muted); max-width: 30ch; margin: 0; line-height: 1.5; }
  .story__hint { display: inline-flex; align-items: center; gap: 10px; margin: 28px 0 0; font-size: var(--fs-label); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); }
  .story__hint-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 0 rgba(224, 165, 38, .55); animation: hintPulse 2.2s ease-out infinite; }
  @keyframes hintPulse { 70% { box-shadow: 0 0 0 10px rgba(224, 165, 38, 0); } 100% { box-shadow: 0 0 0 0 rgba(224, 165, 38, 0); } }

  .story__people { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 32px); }
  .story__person { margin: 0; }
  .story__person--1 { grid-column: 1 / span 6; }
  .story__person--2 { grid-column: 7 / span 6; margin-top: clamp(80px, 14vw, 220px); }

  .story__open { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; perspective: 1100px; text-align: left; }
  .story__open:focus-visible { outline: 2px solid var(--blue); outline-offset: 6px; border-radius: 10px; }
  .story__tilt { position: relative; display: block; transform-style: preserve-3d; will-change: transform; border-radius: var(--image-radius); }
  .story__frame { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--image-radius); box-shadow: 0 30px 60px -40px rgba(40, 30, 15, .5); transition: box-shadow .6s var(--ease-out); }
  .story__frame img {
    width: 100%; height: 100%; display: block; object-fit: cover;
    filter: grayscale(1) contrast(1.04);
    transition: filter 0.9s var(--ease-out), transform 0.9s var(--ease-out);
  }
  .story__shine { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .5s; background: radial-gradient(60% 50% at var(--sx, 30%) var(--sy, 20%), rgba(255, 255, 255, .32), rgba(255, 255, 255, 0) 70%); mix-blend-mode: soft-light; }
  .story__plus {
    position: absolute; right: 16px; bottom: 16px; width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center; background: var(--gold); color: var(--ink);
    transform: translateZ(40px) scale(0.6); opacity: 0;
    transition: transform .5s var(--ease-expo), opacity .3s; box-shadow: 0 10px 24px -8px rgba(0, 0, 0, .4);
  }
  .story__open:hover .story__frame img, .story__open:focus-visible .story__frame img,
  .story__person.is-colour .story__frame img { filter: grayscale(0) contrast(1); }
  .story__open:hover .story__frame { box-shadow: 0 40px 80px -40px rgba(40, 30, 15, .6); }
  .story__open:hover .story__shine { opacity: 1; }
  .story__open:hover .story__plus, .story__open:focus-visible .story__plus { opacity: 1; transform: translateZ(40px) scale(1); }
  .story__person.is-away .story__tilt { visibility: hidden; }

  .story__cap {
    display: flex; justify-content: space-between; gap: 12px; padding-top: 14px; margin-top: 14px;
    border-top: 1px solid rgba(27, 27, 27, 0.18); font-size: var(--fs-label); letter-spacing: 0.08em;
  }
  .story__name { font-weight: 600; color: var(--ink); }
  .story__role { color: var(--muted); text-align: right; }
  .story__more, .story__bio-m { display: none; }

  /* ---------- profile (desktop) ---------- */
  .profile { position: fixed; inset: 0; z-index: 60; }
  .profile[hidden] { display: none; }
  .profile__backdrop { position: absolute; inset: 0; background: radial-gradient(120% 90% at 30% 40%, #F1EBDF, #E6DDCB); }
  .profile__stage {
    position: absolute; inset: 0; display: grid; align-items: center;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(40px, 6vw, 110px);
    padding: clamp(80px, 10vh, 120px) clamp(40px, 7vw, 140px); pointer-events: none;
  }
  .profile__bg {
    position: absolute; right: -2vw; bottom: -6vh; font-family: var(--serif); font-style: italic; font-weight: 400;
    font-size: clamp(180px, 26vw, 460px); line-height: 0.8; letter-spacing: -0.05em;
    color: transparent; -webkit-text-stroke: 1.5px rgba(27, 27, 27, .1); white-space: nowrap; will-change: transform;
  }
  .profile__media { position: relative; justify-self: end; width: min(100%, 64vh); aspect-ratio: 4 / 5; perspective: 1200px; }
  .profile__bodies { position: relative; max-width: 560px; pointer-events: auto; }
  .profile__body[hidden] { display: none; }
  .profile__eyebrow { display: inline-flex; align-items: center; gap: 12px; margin: 0 0 18px; font-size: var(--fs-label); font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
  .profile__eyebrow span { width: 30px; height: 1px; background: var(--gold); }
  .profile__name { margin: 0; font-family: var(--serif); font-weight: 500; font-size: clamp(48px, 5.4vw, 92px); line-height: .95; letter-spacing: -0.025em; color: var(--ink); }
  .profile__name .pw { display: inline-block; white-space: nowrap; margin-right: .22em; overflow: hidden; padding-bottom: .06em; vertical-align: top; }
  .profile__name .pc { display: inline-block; }
  .profile__role { margin: 14px 0 0; font-size: var(--fs-body); color: var(--muted); }
  .profile__rule { display: block; width: 96px; height: 3px; margin: 26px 0; background: var(--gold); border-radius: 2px; transform-origin: left; }
  .profile__quote { margin: 0 0 20px; font-family: var(--serif); font-style: italic; font-size: clamp(22px, 1.9vw, 30px); line-height: 1.3; color: var(--blue); }
  .profile__bio { margin: 0 0 14px; font-size: var(--fs-body); line-height: 1.65; color: #3c3833; max-width: 52ch; }
  .profile__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin: 28px 0 0; padding-top: 22px; border-top: 1px solid rgba(27, 27, 27, .15); }
  .profile__fact { margin: 0; }
  .profile__fact dt { font-family: var(--serif); font-size: clamp(24px, 2.1vw, 34px); line-height: 1; color: var(--ink); }
  .profile__fact dd { margin: 8px 0 0; font-size: var(--fs-label); line-height: 1.4; color: var(--muted); }
  .profile__next {
    display: inline-flex; align-items: center; gap: 12px; margin-top: 34px; padding: 14px 22px;
    border: 1px solid rgba(27, 27, 27, .3); border-radius: 999px; background: none; color: var(--ink);
    font: inherit; font-size: 15px; font-weight: 600; cursor: pointer;
    transition: background-color .35s, color .35s, border-color .35s;
  }
  .profile__next svg { transition: transform .45s var(--ease-expo); }
  .profile__next:hover, .profile__next:focus-visible { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .profile__next:hover svg { transform: translateX(5px); }
  .profile__close {
    position: absolute; top: clamp(20px, 3.5vh, 36px); right: clamp(24px, 3vw, 48px); pointer-events: auto;
    display: inline-flex; align-items: center; gap: 12px; padding: 0; border: 0; background: none;
    font: inherit; font-size: var(--fs-label); font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--ink); cursor: pointer;
  }
  .profile__close i { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; border: 1px solid rgba(27, 27, 27, .25); transition: background-color .35s, color .35s, transform .5s var(--ease-expo); }
  .profile__close:hover i, .profile__close:focus-visible i { background: var(--ink); color: var(--paper); transform: rotate(90deg); }
  :global(html.profile-open #site-nav) { opacity: 0; pointer-events: none; transition: opacity .3s; }
  :global(#site-nav) { transition: opacity .35s, transform 0.5s var(--ease-expo), background-color 0.4s, color 0.4s, border-color 0.4s; }
  :global(.profile-fly) {
    position: fixed; z-index: 61; margin: 0; overflow: hidden; border-radius: var(--image-radius);
    box-shadow: 0 50px 100px -40px rgba(30, 22, 10, .55); pointer-events: none; will-change: transform;
  }
  :global(.profile-fly img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  :global(.profile-fly img.is-grey) { filter: grayscale(1) contrast(1.04); }

  /* ---------- phone / tablet: simple ---------- */
  @media (max-width: 860px), (hover: none) {
    .story__grid { grid-template-columns: 1fr; }
    .story__text { position: static; }
    .story__hint, .story__plus, .story__shine { display: none; }
    .story__person--1 { grid-column: 1 / span 7; }
    .story__person--2 { grid-column: 6 / span 7; margin-top: -18%; position: relative; }
    .story__cap { flex-direction: column; gap: 2px; font-size: 14px; }
    .story__role { text-align: left; }
    .story__open { cursor: default; }
    .story__more {
      display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; padding: 6px 0; border: 0; background: none;
      font: inherit; font-size: 13px; font-weight: 600; color: var(--blue); cursor: pointer;
    }
    .story__more i { position: relative; width: 10px; height: 10px; }
    .story__more i::before, .story__more i::after { content: ''; position: absolute; left: 0; top: 4px; width: 10px; height: 2px; background: currentColor; transition: transform .3s; }
    .story__more i::after { transform: rotate(90deg); }
    .story__more[aria-expanded="true"] i::after { transform: rotate(0); }
    .story__bio-m { display: block; grid-column: 1 / -1; margin: 4px 0 28px; padding-left: 14px; border-left: 2px solid var(--gold); font-size: 15px; line-height: 1.6; color: #3c3833; }
    .story__people.has-open .story__person--2 { margin-top: 8px; }
    .story__bio-m[hidden] { display: none; }
    .story__bio-m p { margin: 8px 0 0; }
    .story__bio-q { font-family: var(--serif); font-style: italic; font-size: 18px; line-height: 1.35; color: var(--blue); }
    .profile { display: none !important; }
  }
  @media (prefers-reduced-motion: reduce) { .story__hint-dot { animation: none; } }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.getElementById('story');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktopMQ = matchMedia('(min-width: 861px) and (hover: hover)');
  const touch = !matchMedia('(hover: hover)').matches;

  // touch devices: portraits turn to colour once they are well in view
  if (root && touch) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => e.target.classList.toggle('is-colour', e.isIntersecting));
    }, { threshold: 0.6 });
    root.querySelectorAll('.story__person').forEach((el) => io.observe(el));
  }

  // phone: read-more toggles
  root?.querySelectorAll<HTMLButtonElement>('[data-story-more]').forEach((b) => {
    b.addEventListener('click', () => {
      const panel = document.getElementById(b.getAttribute('aria-controls') || '');
      if (!panel) return;
      const open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      const wrap = b.closest('.story__people');
      wrap?.classList.toggle('has-open', !!wrap.querySelector('.story__bio-m:not([hidden])'));
      if (open && !reduce) gsap.fromTo(panel, { autoAlpha: 0, y: -8 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' });
      ScrollTrigger.refresh();
    });
  });

  if (root && !reduce) {
    const lines = root.querySelectorAll('.split .line > span');
    const fades = root.querySelectorAll('[data-story-fade]');
    const rule = root.querySelector('[data-story-rule]');
    const media = root.querySelectorAll<HTMLElement>('[data-story-media]');

    gsap.set(lines, { yPercent: 110 });
    gsap.set(fades, { autoAlpha: 0, y: 24 });
    gsap.set(rule, { scaleX: 0 });

    const tl = gsap.timeline({ paused: true, defaults: { ease: 'expo.out', duration: 1.1 } });
    tl.to(fades[0], { autoAlpha: 1, y: 0, duration: 0.8 })
      .to(lines, { yPercent: 0, stagger: 0.12 }, '<0.1')
      .to(rule, { scaleX: 1, duration: 0.9 }, '-=0.7')
      .to([fades[1], fades[2]], { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.12 }, '<0.1');
    ScrollTrigger.create({ trigger: root, start: 'top 72%', once: true, onEnter: () => tl.play() });

    media.forEach((m, i) => {
      const img = m.querySelector('img');
      gsap.set(m, { clipPath: 'inset(100% 0% 0% 0%)' });
      gsap.set(img, { scale: 1.18 });
      const t = gsap.timeline({ paused: true });
      t.to(m, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.3, ease: 'power4.inOut' })
        .to(img, { scale: 1, duration: 1.6, ease: 'expo.out', clearProps: 'transform' }, '<');
      ScrollTrigger.create({ trigger: m, start: 'top 82%', once: true, onEnter: () => t.play() });
      gsap.to(m.closest('.story__person'), {
        yPercent: i === 0 ? -4 : -12, ease: 'none',
        scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: true },
      });
    });

    window.addEventListener('load', () => ScrollTrigger.refresh());
  }

  // ---------------- desktop: 3D tilt + full profile ----------------
  if (root) {
    const profile = root.querySelector<HTMLElement>('[data-profile]')!;
    const slot = profile.querySelector<HTMLElement>('[data-profile-slot]')!;
    const bg = profile.querySelector<HTMLElement>('[data-profile-bg]')!;
    const backdrop = profile.querySelector<HTMLElement>('.profile__backdrop')!;
    const closeBtn = profile.querySelector<HTMLButtonElement>('.profile__close')!;
    document.body.appendChild(profile); // escape the section's stacking context
    const bodies = profile.querySelector<HTMLElement>('.profile__bodies')!;
    let closedByKey = false;
    let openIdx = -1, busy = false, closing = false, openTl: gsap.core.Timeline | null = null, fly: HTMLElement | null = null, lastOpener: HTMLElement | null = null;

    // tilt on hover (desktop only)
    if (!reduce) root.querySelectorAll<HTMLElement>('.story__open').forEach((btn) => {
      const tilt = btn.querySelector<HTMLElement>('[data-tilt]')!;
      const shine = btn.querySelector<HTMLElement>('.story__shine');
      const rx = gsap.quickTo(tilt, 'rotationX', { duration: 0.6, ease: 'power3' });
      const ry = gsap.quickTo(tilt, 'rotationY', { duration: 0.6, ease: 'power3' });
      btn.addEventListener('pointermove', (e) => {
        if (!desktopMQ.matches) return;
        const r = btn.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
        ry((px - 0.5) * 12); rx(-(py - 0.5) * 10);
        shine?.style.setProperty('--sx', `${px * 100}%`); shine?.style.setProperty('--sy', `${py * 100}%`);
      });
      btn.addEventListener('pointerleave', () => { rx(0); ry(0); });
    });

    const lockScroll = (on: boolean) => {
      const lenis = (window as any).__lenis;
      if (lenis) on ? lenis.stop() : lenis.start();
      document.documentElement.style.overflow = on ? 'hidden' : '';
    };

    const bodyOf = (i: number) => profile.querySelector<HTMLElement>(`[data-body="${i}"]`)!;

    const playBody = (i: number) => {
      const b = bodyOf(i);
      b.hidden = false;
      profile.setAttribute('aria-labelledby', `profile-name-${i}`);
      const chars = b.querySelectorAll('.pc');
      const items = b.querySelectorAll('[data-pf]');
      const rule = b.querySelector('[data-pf-rule]');
      const facts = b.querySelectorAll('[data-pf-fact]');
      if (reduce) return gsap.timeline();
      return gsap.timeline()
        .fromTo(chars, { yPercent: 115, rotate: 6 }, { yPercent: 0, rotate: 0, duration: 0.9, ease: 'expo.out', stagger: 0.035 }, 0)
        .fromTo(items, { autoAlpha: 0, y: 22 }, { autoAlpha: 1, y: 0, duration: 0.8, ease: 'expo.out', stagger: 0.09 }, 0.15)
        .fromTo(rule, { scaleX: 0 }, { scaleX: 1, duration: 0.9, ease: 'power3.inOut' }, 0.3)
        .fromTo(facts, { autoAlpha: 0, y: 26 }, { autoAlpha: 1, y: 0, duration: 0.8, ease: 'expo.out', stagger: 0.1 }, 0.55);
    };

    const open = (i: number) => {
      if (busy || !desktopMQ.matches) return;
      busy = true; openIdx = i;
      const person = root.querySelector<HTMLElement>(`[data-person="${i}"]`)!;
      const frame = person.querySelector<HTMLElement>('.story__frame')!;
      const img = frame.querySelector('img')!;
      const from = frame.getBoundingClientRect();

      lockScroll(true);
      profile.hidden = false;
      bg.textContent = bodyOf(i).dataset.bg || '';
      profile.querySelectorAll<HTMLElement>('.profile__body').forEach((b) => (b.hidden = true));
      gsap.set(bodies, { autoAlpha: 1, y: 0 });
      const to = slot.getBoundingClientRect();

      fly = document.createElement('div');
      fly.className = 'profile-fly';
      const fimg = img.cloneNode() as HTMLImageElement;
      fimg.removeAttribute('loading');
      const grey = fimg.cloneNode() as HTMLImageElement;
      grey.classList.add('is-grey');
      fly.append(fimg, grey);
      document.body.appendChild(fly);
      gsap.set(fly, { left: to.left, top: to.top, width: to.width, height: to.height, transformOrigin: '0 0',
        x: from.left - to.left, y: from.top - to.top, scaleX: from.width / to.width, scaleY: from.height / to.height });
      profile.style.zIndex = '60';
      document.documentElement.classList.add('profile-open');
      person.classList.add('is-away');

      const d = reduce ? 0 : 1;
      openTl = gsap.timeline({ onComplete: () => { busy = false; openTl = null; closeBtn.focus({ preventScroll: true }); } })
        .fromTo(backdrop, { opacity: 0 }, { opacity: 1, duration: 0.4 * d, ease: 'power2.out' }, 0)
        .fromTo(closeBtn, { autoAlpha: 0, y: -10 }, { autoAlpha: 1, y: 0, duration: 0.5 * d }, 0.4 * d)
        .fromTo(bg, { autoAlpha: 0, xPercent: 8 }, { autoAlpha: 1, xPercent: 0, duration: 1.4 * d, ease: 'expo.out' }, 0.2 * d)
        .to(fly, { x: 0, y: 0, scaleX: 1, scaleY: 1, duration: 0.85 * d, ease: 'expo.inOut' }, 0)
        .to(grey, { opacity: 0, duration: 0.7 * d, ease: 'none' }, 0.2 * d)
        .add(playBody(i), 0.45 * d);
    };

    const close = (then?: () => void) => {
      if (closing || openIdx < 0 || !fly) return;
      closing = true;
      // closing works at any moment, even while the opening animation is still playing
      if (openTl) { openTl.kill(); openTl = null; }
      const i = openIdx;
      const person = root.querySelector<HTMLElement>(`[data-person="${i}"]`)!;
      const frameEl = person.querySelector<HTMLElement>('.story__frame')!;
      gsap.set(person.querySelector('[data-tilt]'), { rotationX: 0, rotationY: 0 });
      if (!then) {
        // the profile still covers the page, so quietly scroll the portrait fully into view
        // (below the nav) before measuring; the photo then lands exactly on it, never off-screen
        const r0 = frameEl.getBoundingClientRect();
        const top = 96, bottom = innerHeight - 24;
        let dy = 0;
        if (r0.height > bottom - top) dy = r0.top - top;
        else if (r0.top < top) dy = r0.top - top;
        else if (r0.bottom > bottom) dy = r0.bottom - bottom;
        if (Math.abs(dy) > 1) {
          const lenis = (window as any).__lenis;
          const y = Math.max(0, scrollY + dy);
          if (lenis) lenis.scrollTo(y, { immediate: true, force: true }); else window.scrollTo(0, y);
          window.scrollTo(0, y);
          ScrollTrigger.update();
        }
      }
      const to = frameEl.getBoundingClientRect();
      const s = slot.getBoundingClientRect();
      const b = bodyOf(i);
      const f = fly;
      const d = reduce ? 0 : 1;
      const grey = f.querySelector('img.is-grey');
      gsap.killTweensOf([f, grey, bg, closeBtn, backdrop]);
      // fly home underneath the nav bar, and bring the nav back straight away
      profile.style.zIndex = '45'; f.style.zIndex = '46';
      if (!then) document.documentElement.classList.remove('profile-open');
      gsap.timeline({
        onComplete: () => {
          person.classList.remove('is-away');
          f.remove(); fly = null; b.hidden = true; openIdx = -1; busy = false; closing = false;
          if (then) { then(); return; }
          profile.hidden = true; lockScroll(false);
          if (closedByKey) (lastOpener ?? person.querySelector<HTMLElement>('.story__open'))?.focus({ preventScroll: true });
          else (document.activeElement as HTMLElement | null)?.blur?.();
          closedByKey = false;
        },
      })
        // text, close button and background word go first and fast
        .to(bodies, { autoAlpha: 0, y: -8, duration: 0.15 * d, ease: 'power2.in' }, 0)
        .to([closeBtn, bg], { autoAlpha: 0, duration: 0.15 * d, ease: 'power2.in' }, 0)
        // the photo glides home while the backdrop clears
        .to(f, { x: to.left - s.left, y: to.top - s.top, scaleX: to.width / s.width, scaleY: to.height / s.height, rotationX: 0, rotationY: 0, duration: 0.5 * d, ease: 'power3.out' }, 0)
        .to(grey, { opacity: 1, duration: 0.4 * d, ease: 'power1.out' }, 0)
        .to(backdrop, { opacity: then ? 1 : 0, duration: 0.35 * d, ease: 'power2.out' }, 0.12 * d);
    };

    root.querySelectorAll<HTMLElement>('[data-story-open]').forEach((btn) => btn.addEventListener('click', () => {
      lastOpener = btn; open(Number(btn.dataset.storyOpen));
    }));
    profile.querySelectorAll('[data-profile-close]').forEach((el) => el.addEventListener('click', () => close()));
    profile.querySelectorAll<HTMLElement>('[data-profile-next]').forEach((el) => el.addEventListener('click', () => {
      const j = Number(el.dataset.profileNext);
      lastOpener = root.querySelector<HTMLElement>(`[data-story-open="${j}"]`);
      close(() => open(j));
    }));
    document.addEventListener('keydown', (e) => {
      if (profile.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); closedByKey = true; close(); }
      if (e.key === 'Tab') { // keep focus inside the profile
        const f = Array.from(profile.querySelectorAll<HTMLElement>('button')).filter((x) => x.offsetParent !== null);
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    // depth: the photo tilts and the background word drifts with the mouse
    if (!reduce) {
      const bx = gsap.quickTo(bg, 'x', { duration: 1.2, ease: 'power3' });
      const by = gsap.quickTo(bg, 'y', { duration: 1.2, ease: 'power3' });
      profile.addEventListener('pointermove', (e) => {
        const px = e.clientX / innerWidth - 0.5, py = e.clientY / innerHeight - 0.5;
        bx(-px * 60); by(-py * 30);
        if (fly && !busy && !closing) gsap.to(fly, { rotationY: px * 8, rotationX: -py * 6, transformPerspective: 1200, duration: 0.8, ease: 'power3' });
      });
    }
    addEventListener('resize', () => { if (!profile.hidden && !desktopMQ.matches) { close(); } });
  }
</script>
