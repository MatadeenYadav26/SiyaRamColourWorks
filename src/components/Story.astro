---
import { story } from '../content/site';
---
<section id="story" class="story tint-linen" aria-labelledby="story-title">
  <div class="wrap story__grid">
    <div class="story__text">
      <p class="label" data-story-fade>{story.label}</p>
      <h2 id="story-title" class="story__title split">
        {story.heading.map((l) => (
          <span class="line"><span>{l}</span></span>
        ))}
      </h2>
      <span class="story__rule" aria-hidden="true" data-story-rule></span>
      <p class="story__lead" data-story-fade>{story.line}</p>
    </div>
    <div class="story__people">
      {story.people.map((p, i) => (
        <figure class={`story__person story__person--${i + 1}`}>
          <div class="story__frame reveal" data-story-media>
            <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
          </div>
          <figcaption class="story__cap">
            <span class="story__name">{p.name}</span>
            <span class="story__role">{p.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .story { position: relative; z-index: 3; padding-block: var(--section-y); }
  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 112px);
    align-items: start;
  }
  .story__text { position: sticky; top: 18vh; }
  .story__title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--fs-h2);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: clamp(18px, 2vw, 28px) 0 0;
  }
  .story__title .line { display: block; }
  .story__rule {
    display: block;
    width: clamp(64px, 8vw, 120px);
    height: 2px;
    background: var(--gold);
    margin: clamp(24px, 3vw, 40px) 0;
    transform-origin: left center;
  }
  .story__lead { font-size: var(--fs-lead); color: var(--muted); max-width: 30ch; margin: 0; line-height: 1.5; }

  .story__people {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
  }
  .story__person { margin: 0; }
  .story__person--1 { grid-column: 1 / span 6; }
  .story__person--2 { grid-column: 7 / span 6; margin-top: clamp(80px, 14vw, 220px); }
  .story__frame { aspect-ratio: 4 / 5; }
  .story__frame img {
    width: 100%; height: 100%; display: block;
    filter: grayscale(1) contrast(1.04);
    transition: filter 0.9s var(--ease-out), transform 0.9s var(--ease-out);
  }
  .story__person:hover .story__frame img,
  .story__person.is-colour .story__frame img { filter: grayscale(0) contrast(1); }
  .story__cap {
    display: flex; justify-content: space-between; gap: 12px;
    padding-top: 14px; margin-top: 14px;
    border-top: 1px solid rgba(27, 27, 27, 0.18);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
  }
  .story__name { font-weight: 600; color: var(--ink); }
  .story__role { color: var(--muted); text-align: right; }

  @media (max-width: 860px) {
    .story__grid { grid-template-columns: 1fr; }
    .story__text { position: static; }
    .story__person--1 { grid-column: 1 / span 7; }
    .story__person--2 { grid-column: 6 / span 7; margin-top: -18%; position: relative; }
    .story__cap { flex-direction: column; gap: 2px; }
    .story__role { text-align: left; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.getElementById('story');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch = !matchMedia('(hover: hover)').matches;

  // touch devices: portraits turn to colour once they are well in view
  if (root && touch) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => e.target.classList.toggle('is-colour', e.isIntersecting));
    }, { threshold: 0.6 });
    root.querySelectorAll('.story__person').forEach((el) => io.observe(el));
  }

  if (root && !reduce) {
    const lines = root.querySelectorAll('.split .line > span');
    const fades = root.querySelectorAll('[data-story-fade]');
    const rule = root.querySelector('[data-story-rule]');
    const media = root.querySelectorAll<HTMLElement>('[data-story-media]');

    gsap.set(lines, { yPercent: 110 });
    gsap.set(fades, { autoAlpha: 0, y: 24 });
    gsap.set(rule, { scaleX: 0 });

    const tl = gsap.timeline({ paused: true, defaults: { ease: 'expo.out', duration: 1.1 } });
    tl.to(fades[0], { autoAlpha: 1, y: 0, duration: 0.8 })
      .to(lines, { yPercent: 0, stagger: 0.12 }, '<0.1')
      .to(rule, { scaleX: 1, duration: 0.9 }, '-=0.7')
      .to(fades[1], { autoAlpha: 1, y: 0, duration: 0.8 }, '<0.1');
    ScrollTrigger.create({ trigger: root, start: 'top 72%', once: true, onEnter: () => tl.play() });

    media.forEach((m, i) => {
      const img = m.querySelector('img');
      gsap.set(m, { clipPath: 'inset(100% 0% 0% 0%)' });
      gsap.set(img, { scale: 1.18 });
      const t = gsap.timeline({ paused: true });
      t.to(m, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.3, ease: 'power4.inOut' })
        .to(img, { scale: 1, duration: 1.6, ease: 'expo.out' }, '<');
      ScrollTrigger.create({ trigger: m, start: 'top 82%', once: true, onEnter: () => t.play() });
      // offset parallax: second portrait drifts faster
      gsap.to(m.parentElement, {
        yPercent: i === 0 ? -4 : -12,
        ease: 'none',
        scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: true },
      });
    });

    window.addEventListener('load', () => ScrollTrigger.refresh());
  }
</script>
