---
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../content/site';
import Grain from '../components/Grain.astro';
import Cursor from '../components/Cursor.astro';
import PaintBlobs from '../components/PaintBlobs.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Nav from '../components/Nav.astro';
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
// Structured data so Google understands this is a local painting business.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HousePainter',
  name: site.name,
  url: site.url,
  logo: `${site.url}images/logo-final.webp`,
  image: `${site.url}images/og-image.jpg`,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  foundingDate: '1995',
  founder: { '@type': 'Person', name: 'Vinod Yadav' },
  address: { '@type': 'PostalAddress', addressLocality: 'Surat', addressRegion: 'Gujarat', addressCountry: 'IN' },
  areaServed: { '@type': 'City', name: 'Surat' },
  sameAs: [site.INSTAGRAM_URL],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={`${site.url}images/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#F4F0E8" />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon-logo.png`} />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Manrope:wght@400;500;600;700&family=Montserrat:wght@600;700;800;900&display=swap"
    />
  </head>
  <body>
    <Grain />
    <PaintBlobs />
    <Nav />
    <main>
      <slot />
    </main>
    <WhatsAppFab />
    <Cursor />
  </body>
</html>
